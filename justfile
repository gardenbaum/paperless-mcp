_default:
    @just --list

# Paperless-ngx release whose API schema and docs are vendored (docs/vendor/paperless) and the
# reference version for development and E2E. Single source: bump here, then `just docs-sync-paperless`.
PAPERLESS_VERSION := "3.4.2"

# Refresh the vendored FastMCP docs to the latest stable release tag (highest vX.Y.Z; no
# pre-releases). Only the docs/ subtree is copied, FastMCP's repo-root files (its own
# CLAUDE.md/AGENTS.md) never are. The prune drops legacy v2/v3 docs, contributor docs and binary media.
# Everything is fetched and staged in a temp dir first: the committed copy is replaced only after
# every step succeeded, so a failure leaves it untouched. UPSTREAM marker: "<commit> <tag>".
docs-sync:
    #!/usr/bin/env bash
    set -euo pipefail
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    repo="${FASTMCP_REPO:-https://github.com/PrefectHQ/fastmcp}"
    tag="$(git ls-remote --tags --refs "$repo" | sed 's#.*refs/tags/##' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1)"
    [[ -n "$tag" ]] || { echo "docs-sync: no vX.Y.Z tag found in $repo" >&2; exit 1; }
    git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$tag" --filter=blob:none --sparse "$repo" "$tmp/src"
    git -C "$tmp/src" sparse-checkout set docs
    mkdir -p "$tmp/out"
    cp -R "$tmp/src/docs" "$tmp/out/docs"
    rm -rf "$tmp/out/docs/v2" "$tmp/out/docs/v3"
    # Images and videos (about 40 MB) are of no use to an agent reading the text; docs link to them.
    find "$tmp/out/docs" -type f \( -name '*.png' -o -name '*.jpg' -o -name '*.jpeg' -o -name '*.gif' -o -name '*.webp' -o -name '*.mp4' \) -delete
    rm -f "$tmp/out/docs/development/contributing.mdx" \
          "$tmp/out/docs/development/releases.mdx" \
          "$tmp/out/docs/development/tests.mdx"
    echo "$(git -C "$tmp/src" rev-parse HEAD) $tag" > "$tmp/out/UPSTREAM"
    rm -rf docs/vendor/fastmcp
    mkdir -p docs/vendor
    mv "$tmp/out" docs/vendor/fastmcp
    echo "FastMCP docs synced: $(cat docs/vendor/fastmcp/UPSTREAM)"

# Refresh the vendored paperless-ngx reference at PAPERLESS_VERSION: openapi.json generated by
# drf-spectacular inside the pinned image (the schema the adapter tests validate against), plus the
# API and usage docs (search/query language, workflows, permissions, AI) from the same git tag.
# Same failure safety as docs-sync (stage in a temp dir, replace last). UPSTREAM marker:
# "<commit> v<version> image-digest <digest>".
docs-sync-paperless:
    #!/usr/bin/env bash
    set -euo pipefail
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    version="${PAPERLESS_VERSION_OVERRIDE:-{{PAPERLESS_VERSION}}}"
    repo="${PAPERLESS_REPO:-https://github.com/paperless-ngx/paperless-ngx}"
    # PAPERLESS_DOCS_DIR: write elsewhere (drift-check generates a fresh copy to compare).
    target="${PAPERLESS_DOCS_DIR:-docs/vendor/paperless}"
    image="ghcr.io/paperless-ngx/paperless-ngx:$version"
    git -c advice.detachedHead=false clone --quiet --depth 1 --branch "v$version" --filter=blob:none --sparse "$repo" "$tmp/src"
    git -C "$tmp/src" sparse-checkout set docs
    docker pull --quiet "$image" > /dev/null
    digest="$(docker image inspect "$image" --format '{{{{index .RepoDigests 0}}')"
    digest="${digest#*@}"
    mkdir -p "$tmp/out"
    # Overriding the entrypoint skips the s6 init (database, redis); the schema needs only a secret key.
    docker run --rm --entrypoint "" -e PAPERLESS_SECRET_KEY=docs-sync "$image" \
        python3 manage.py spectacular --format openapi-json > "$tmp/openapi.raw.json"
    # Pretty-printed for reviewable diffs; also proves the output is valid JSON.
    uv run python -m json.tool --indent 2 "$tmp/openapi.raw.json" "$tmp/out/openapi.json"
    grep -q '"/api/documents/"' "$tmp/out/openapi.json" \
        || { echo "docs-sync-paperless: /api/documents/ missing from the generated schema" >&2; exit 1; }
    for f in api.md usage.md advanced_usage.md migration-v3.md; do
        cp "$tmp/src/docs/$f" "$tmp/out/$f"
    done
    echo "$(git -C "$tmp/src" rev-parse HEAD) v$version image-digest $digest" > "$tmp/out/UPSTREAM"
    rm -rf "$target"
    mkdir -p "$(dirname "$target")"
    mv "$tmp/out" "$target"
    echo "Paperless docs synced: $(cat "$target/UPSTREAM")"

# Install or update the development environment.
install:
    uv sync

# Lint: ruff, then the suppression and patching rules ruff cannot express.
lint: && hygiene
    uv run ruff check .

# The only suppressions are `# noqa: S101 -- why` and `# pyright: ignore[reportAny] -- why`:
# a specific code and a reason. Unused ones fail ruff (RUF100) and basedpyright. Not used at all:
# `# type: ignore` (blanket in pyright), `# pragma` (coverage exclusions are reviewed patterns
# in pyproject.toml), and file or range directives (`# ruff:`, `# flake8:`, `# isort:`):
# per-file exceptions belong in pyproject.toml with a reason.
# Patching (monkeypatch.setattr, setattr & co.) is banned: the only test seams are constructor
# injection and the HTTP transport.
hygiene:
    #!/usr/bin/env bash
    set -euo pipefail
    # git grep exits 1 when nothing matches; any other failure must fail the gate, not pass it.
    search() {
        local status=0
        git grep --untracked -nI "$@" -- '*.py' ':(exclude)docs/vendor' || status=$?
        if (( status > 1 )); then
            echo "hygiene: git grep failed with exit code $status" >&2
            exit "$status"
        fi
    }
    directive='#[[:space:]]*(noqa|ruff:|flake8|isort|type:[[:space:]]*ignore|pyright:|pragma)[^#]*'
    valid='^[^:]+:[0-9]+:# (noqa: [A-Z]+[0-9]+(, [A-Z]+[0-9]+)*|pyright: ignore\[[A-Za-z]+(, [A-Za-z]+)*\]) -- [^[:space:]]'
    directives="$(search -ioE "$directive")"
    bad=""
    while IFS= read -r line; do
        [[ -z "$line" || "$line" =~ $valid ]] || bad+="$line"$'\n'
    done <<< "$directives"
    patching="$(search -E '(^|[^[:alnum:]_])(setattr|delattr|setitem|delitem)\(')"
    status=0
    if [[ -n "$bad" ]]; then
        printf 'Suppression not in the form `# noqa: CODE -- reason` / `# pyright: ignore[rule] -- reason`:\n%s\n' "$bad"
        status=1
    fi
    if [[ -n "$patching" ]]; then
        printf 'Patching is banned; inject a fake through the constructor or the HTTP transport:\n%s\n\n' "$patching"
        status=1
    fi
    exit "$status"

# Format with ruff.
format:
    uv run ruff format .

# Verify formatting without writing.
format-check:
    uv run ruff format --check .

# Type-check src and tests (basedpyright, see pyproject.toml for the mode). basedpyright would
# silently accept every error recorded in a baseline file, so none may exist.
typecheck:
    @if [ -e .basedpyright/baseline.json ]; then echo "typecheck: remove .basedpyright/baseline.json; fix the errors or suppress each with a reason" >&2; exit 1; fi
    uv run basedpyright

# Architecture contracts (design §5.1).
imports:
    uv run lint-imports --no-logo

# Dependency hygiene: declare what you import, import what you declare.
deps:
    uv run deptry src

# Run the tests with branch coverage (fails below 95 %); writes coverage.xml for cov-diff.
test:
    uv run pytest --cov --cov-report=term-missing --cov-report=xml

# Require 100 % coverage on the lines changed against `base` (CI passes origin/main).
cov-diff base="main": test
    uv run diff-cover coverage.xml --compare-branch={{base}} --fail-under=100 --include-untracked

# Fail if uv.lock does not match pyproject.toml. Runs first in `check`: `uv run` re-locks.
lock-check:
    uv lock --check

# Scan the whole git history for secrets (gitleaks, pinned and installed by pre-commit). The
# commit hook only sees staged changes.
secrets:
    uv run pre-commit run gitleaks-history --hook-stage manual --all-files

# The full local gate; CI's check job runs the same recipes. `audit` needs the network.
check: lock-check lint format-check typecheck imports deps secrets cov-diff

# Start the Paperless 3.4.2 E2E stack (tests/e2e/compose.yaml) on 127.0.0.1:${PAPERLESS_E2E_PORT:-8010}.
# Readiness and seeding are the test session's job, so this returns as soon as the containers run.
e2e-up:
    docker compose -f tests/e2e/compose.yaml up -d

# Run only the E2E tests (marker `e2e`, deselected by `check`) against the stack, starting it if needed.
# The stack is left running for fast reruns; the seeding is idempotent. No coverage: E2E tests do not count.
e2e: e2e-up
    uv run pytest -m e2e --no-cov

# Run the E2E tests against the latest stable paperless-ngx 3.x image (weekly job; design 9.2),
# not the pinned one. Own compose project and port (8011), so a stack from `e2e-up` is untouched.
# PAPERLESS_E2E_VERSION pins a release instead of resolving the highest 3.x.y tag; the tests read
# the expected version from it. Container logs of a failed run land in e2e-containers.log.
e2e-latest:
    #!/usr/bin/env bash
    set -euo pipefail
    repo="${PAPERLESS_REPO:-https://github.com/paperless-ngx/paperless-ngx}"
    image="ghcr.io/paperless-ngx/paperless-ngx"
    if [[ -n "${PAPERLESS_E2E_VERSION:-}" ]]; then
        PAPERLESS_E2E_VERSION="$(uv run python scripts/scheduled_jobs.py release "$PAPERLESS_E2E_VERSION" --major 3)"
    else
        # Highest 3.x.y tag whose image is already published (a tag can precede its image).
        PAPERLESS_E2E_VERSION="$(git ls-remote --tags --refs "$repo" | uv run python scripts/scheduled_jobs.py latest --major 3 --image "$image")"
    fi
    export PAPERLESS_E2E_VERSION
    export PAPERLESS_E2E_PORT="${PAPERLESS_E2E_PORT:-8011}"
    compose=(docker compose -p paperless-mcp-e2e-latest -f tests/e2e/compose.yaml -f tests/e2e/compose.latest.yaml)
    cleanup() {
        local status=$?
        if (( status != 0 )); then "${compose[@]}" logs --no-color > e2e-containers.log || true; fi
        "${compose[@]}" down --volumes --remove-orphans
    }
    trap cleanup EXIT
    echo "E2E against paperless-ngx $PAPERLESS_E2E_VERSION on port $PAPERLESS_E2E_PORT"
    "${compose[@]}" up -d
    uv run pytest -m e2e --no-cov

# Stop the E2E stack and delete its volumes, so the next start is a fresh instance.
e2e-down:
    docker compose -f tests/e2e/compose.yaml down --volumes --remove-orphans

# Audit the locked dependencies for known vulnerabilities. Triaged false positives are
# suppressed by ID in .pip-audit-ignore.
audit:
    #!/usr/bin/env bash
    set -euo pipefail
    requirements="$(mktemp)"
    trap 'rm -f "$requirements"' EXIT
    uv export --frozen --no-emit-project --all-groups \
        --format requirements-txt --output-file "$requirements" --quiet
    ignore=()
    while read -r id; do
        case "$id" in ''|\#*) continue ;; esac
        ignore+=("--ignore-vuln=$id")
    done < .pip-audit-ignore
    # The export pins and hashes every transitive dependency: audit it as-is, without resolving.
    # (`${ignore[@]+...}`: an empty array is "unbound" under `set -u` in macOS's bash 3.2.)
    uvx pip-audit==2.10.1 --strict --disable-pip --requirement "$requirements" ${ignore[@]+"${ignore[@]}"}

# Mutation testing of services/ and paperless/ with mutmut (weekly job; design 9.2): non-E2E
# tests only, takes about five minutes. Fails (exit 3) below the 80 % gate (MUTATION_GATE in
# scripts/scheduled_jobs.py) after printing the summary; mutation-equivalents.toml lists the
# reviewed survivors no test can kill. Extra arguments select mutants, e.g.
# `just mutation 'paperless_mcp.services.instance*'`, which also scores earlier results of
# mutants/, so a selection can fail the gate. Delete mutants/ to start from scratch. Writes
# mutants/summary.md (the score as Markdown) and mutants/survivors.txt.
[positional-arguments]
mutation *selection:
    #!/usr/bin/env bash
    set -euo pipefail
    if (( $# > 0 )); then
        echo "note: with a selection the score aggregates earlier results of mutants/ (delete it for a clean score)" >&2
    fi
    uv run mutmut run "$@"
    uv run mutmut export-cicd-stats
    uv run mutmut results > mutants/survivors.txt
    # pipefail makes the recipe fail with the script's exit code, after tee wrote the summary.
    uv run python scripts/scheduled_jobs.py mutation-score mutants/mutmut-cicd-stats.json --results mutants/survivors.txt --equivalents mutation-equivalents.toml | tee mutants/summary.md

# Compare the vendored Paperless schema and docs with the latest stable 3.x release (weekly job;
# design 9.5). Needs docker and the network; changes nothing in the repository. DRIFT_REPORT=path
# also copies the report there (drift-issue reads it); the exit code is 0 with or without drift.
drift-check:
    #!/usr/bin/env bash
    set -euo pipefail
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    repo="${PAPERLESS_REPO:-https://github.com/paperless-ngx/paperless-ngx}"
    latest="$(git ls-remote --tags --refs "$repo" | uv run python scripts/scheduled_jobs.py latest --major 3 --image ghcr.io/paperless-ngx/paperless-ngx)"
    PAPERLESS_VERSION_OVERRIDE="$latest" PAPERLESS_DOCS_DIR="$tmp/fresh" {{just_executable()}} docs-sync-paperless
    status=0
    uv run python scripts/scheduled_jobs.py drift docs/vendor/paperless "$tmp/fresh" --report "$tmp/report.md" || status=$?
    # 10 is DRIFT_EXIT_CODE in scripts/scheduled_jobs.py; keep the two in step.
    if (( status == 10 )); then
        cat "$tmp/report.md"
        if [[ -n "${DRIFT_REPORT:-}" ]]; then cp "$tmp/report.md" "$DRIFT_REPORT"; fi
    elif (( status != 0 )); then
        exit "$status"
    elif [[ -n "${DRIFT_REPORT:-}" ]]; then
        # No drift: drop a report left by an earlier run, so drift-issue closes the issue.
        rm -f -- "$DRIFT_REPORT"
    fi

# Report the result of `drift-check` (its DRIFT_REPORT file) as the one GitHub issue labelled
# paperless-drift, through `gh` (needs GH_TOKEN with issues: write): open it, or refresh it with a
# comment; with no report file (no drift) close it. Never duplicates an open issue.
drift-issue report="drift-report.md":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -f "{{report}}" ]]; then
        uv run python scripts/scheduled_jobs.py open-issue \
            --title "Vendored Paperless reference differs from the latest 3.x release" \
            --label paperless-drift --body-file "{{report}}"
    else
        uv run python scripts/scheduled_jobs.py close-issue --label paperless-drift \
            --comment "Resolved: the vendored Paperless reference matches the latest 3.x release again."
    fi

# Run every pre-commit hook on all files.
precommit:
    uv run pre-commit run --all-files
