# name: test_the_words_of_an_outcome_that_is_not_a_plain_success
  dict({
    'no document': 'Paperless consumed the file but names no document for it (it may have been split into several, or the new document is hidden from this user).',
    'unreadable task': 'Paperless accepted the file, but its task could not be read (unexpected error); the outcome is unknown. Follow the task with get_task.',
  })
