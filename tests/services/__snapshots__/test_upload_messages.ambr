  dict({
    'blank title': 'Validation: The title cannot be blank. Hint: Pass a title, or leave it out to use the file name.',
    'long title': 'Validation: The title is longer than 128 characters. Hint: Shorten the title.',
    'serial number': 'Validation: The archive serial number must be between 0 and 4294967295. Hint: Pass an unused whole number in that range.',
