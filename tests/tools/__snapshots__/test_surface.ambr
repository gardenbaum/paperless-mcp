            'anyOf': list([
              dict({
                'format': 'date',
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Creation date (YYYY-MM-DD); default: Paperless reads it.',
          }),
          'custom_fields': dict({
            'anyOf': list([
              dict({
                'additionalProperties': dict({
                }),
                'type': 'object',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "Custom field values keyed by field name or id. Values by data type: string/longtext text; url with scheme; date 'YYYY-MM-DD'; boolean true/false; integer; float; monetary 'EUR12.50' (or 12.5); documentlink a list of document ids; select the option's label.",
