        'additionalProperties': False,
        'properties': dict({
          'archive_serial_number': dict({
            'anyOf': list([
              dict({
                'minimum': 0,
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'New archive serial number; it must be unused.',
          }),
          'clear': dict({
            'anyOf': list([
              dict({
                'items': dict({
                  'enum': list([
                    'correspondent',
                    'document_type',
                    'storage_path',
                    'archive_serial_number',
