            ]),
            'default': None,
            'description': 'Title (at most 128 characters); default: the file name without extension.',
          }),
          'wait_seconds': dict({
            'default': 0,
            'description': 'Wait up to this many seconds for Paperless to consume the file and return the new document_id; more than 30 is cut to 30. 0 returns the task id at once; follow it with get_task.',
            'minimum': 0,
            'type': 'integer',
