# name: test_the_surface_matches_the_snapshot[read-only]
  list([
    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'ai',
          ]),
        }),
      }),
      'annotations': dict({
        'idempotentHint': False,
        'openWorldHint': True,
        'readOnlyHint': True,
        'title': 'Ask Paperless AI',
      }),
      'description': '''
        Ask Paperless's AI a question about your documents and get its complete answer.
        
        Paperless retrieves passages of the documents the user may see (or of one document) and a
        language model writes the answer; this can take a minute and sends document text to the
        model backend. Answers are not repeatable and can be wrong: check the sources, which are
        at most three documents with web_url, or read them with get_document_content. The answer
        can be cut (truncated true). To find documents, search_documents is faster and exact.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'document_id': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Ask about this one document (id from search_documents); default all.',
          }),
          'question': dict({
            'description': 'The question in natural language, at most 4000 characters.',
            'maxLength': 4000,
            'minLength': 1,
            'type': 'string',
          }),
        }),
        'required': list([
          'question',
        ]),
        'type': 'object',
      }),
      'name': 'ask_paperless_ai',
      'outputSchema': dict({
        'description': 'The answer of the Paperless AI chat and the documents it drew on.',
        'properties': dict({
          'answer': dict({
            'type': 'string',
          }),
          'sources': dict({
            'description': 'Documents the answer drew on, as Paperless named them; may be empty.',
            'items': dict({
              'description': 'A document an answer drew on.',
              'properties': dict({
                'id': dict({
                  'type': 'integer',
                }),
                'title': dict({
                  'type': 'string',
                }),
                'web_url': dict({
                  'type': 'string',
                }),
              }),
              'required': list([
                'id',
                'title',
                'web_url',
              ]),
              'type': 'object',
            }),
            'type': 'array',
          }),
          'truncated': dict({
            'description': 'True if the answer was cut at the size or time limit.',
            'type': 'boolean',
          }),
        }),
        'required': list([
          'answer',
          'truncated',
          'sources',
        ]),
        'type': 'object',
      }),
      'title': 'Ask Paperless AI',
    }),
    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'core',
          ]),
        }),
      }),
      'annotations': dict({
        'idempotentHint': True,
        'openWorldHint': False,
        'readOnlyHint': True,
        'title': 'Download document',
      }),
      'description': '''
        Get the original file of a document, or its archive version, as an embedded resource.
        
        The file comes attached as MCP content with its MIME type and file name (also in the JSON
        report before it), never written to disk. A file over the server's download limit (512 KiB
        unless the administrator changed it) is not attached: delivered is false and the report holds
        its web_url. Use get_document_content when you only need the text.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'document_id': dict({
            'description': 'Document id, from search_documents.',
            'type': 'integer',
          }),
          'kind': dict({
            'default': 'original',
            'description': 'original: the file as it was uploaded. archive: the searchable PDF/A Paperless made from it; not every document has one (text files do not).',
            'enum': list([
              'original',
              'archive',
            ]),
            'type': 'string',
          }),
        }),
        'required': list([
          'document_id',
        ]),
        'type': 'object',
      }),
      'name': 'download_document',
      'title': 'Download document',
    }),
