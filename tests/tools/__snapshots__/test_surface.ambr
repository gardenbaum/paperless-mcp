# name: test_the_resource_templates_match_the_snapshot[all]
  list([
    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'core',
          ]),
        }),
      }),
      'description': 'A document as get_document returns it, without the include sections or the text.',
      'mimeType': 'application/json',
      'name': 'document',
      'title': 'Document',
      'uriTemplate': 'paperless://documents/{document_id}',
    }),
    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'core',
          ]),
        }),
      }),
      'description': "The searchable PDF/A Paperless made from the upload, within the server's download limit.",
      'mimeType': 'application/pdf',
      'name': 'document_archive',
      'title': 'Document archive version',
      'uriTemplate': 'paperless://documents/{document_id}/archive',
    }),
    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'core',
          ]),
        }),
      }),
      'description': 'A slice of the OCR text as get_document_content returns it (first 20000 characters).',
      'mimeType': 'application/json',
      'name': 'document_content',
      'title': 'Document content',
      'uriTemplate': 'paperless://documents/{document_id}/content{?offset,max_chars}',
    }),
    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'core',
          ]),
        }),
      }),
      'description': "The file as uploaded (its own MIME type and name), within the server's download limit.",
      'mimeType': 'application/octet-stream',
      'name': 'document_original',
      'title': 'Document original file',
      'uriTemplate': 'paperless://documents/{document_id}/original',
    }),
    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'core',
          ]),
        }),
      }),
      'description': 'The thumbnail image of a document, as get_document_thumbnail returns it.',
      'mimeType': 'image/webp',
      'name': 'document_thumbnail',
      'title': 'Document thumbnail',
      'uriTemplate': 'paperless://documents/{document_id}/thumbnail',
    }),
    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'core',
          ]),
        }),
      }),
      'description': '''
        Every tag, correspondent, document type, storage path, custom field, saved view, user or
        group the current user may see, as JSON rows with id, name and document count.
      ''',
      'mimeType': 'application/json',
      'name': 'taxonomy',
      'title': 'Taxonomy table',
      'uriTemplate': 'paperless://taxonomy/{kind}',
    }),
  ])
