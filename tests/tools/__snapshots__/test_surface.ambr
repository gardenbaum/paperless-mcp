            'description': "The file's name, e.g. 'Rechnung März.pdf'. Directories are dropped, other characters (non-ASCII too) are kept; Paperless keeps it as the original name.",
            'minLength': 1,
            'type': 'string',
          }),
          'storage_path': dict({
            'anyOf': list([
