        'readOnlyHint': True,
        'title': 'Get document content',
      }),
      'description': '''
        Read the OCR text of a document in slices of max_chars characters (default 20000).
        
        total_chars is the length of the whole text; while next_offset is set, pass it as offset
        to read on. An offset past the end returns an empty slice with total_chars. Prefer
        search_documents with a full-text query to find the passage you need first.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'document_id': dict({
            'description': 'Document id, from search_documents.',
            'type': 'integer',
          }),
          'max_chars': dict({
            'default': 20000,
            'description': 'Characters to return, at most 20000.',
            'maximum': 20000,
            'minimum': 1,
            'type': 'integer',
          }),
          'offset': dict({
            'default': 0,
            'description': 'Character offset to start at.',
            'minimum': 0,
            'type': 'integer',
          }),
        }),
        'required': list([
          'document_id',
        ]),
        'type': 'object',
      }),
      'name': 'get_document_content',
      'outputSchema': dict({
        'description': 'A slice of the OCR text of a document.',
        'properties': dict({
          'content': dict({
            'type': 'string',
          }),
          'document_id': dict({
            'type': 'integer',
          }),
          'next_offset': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'description': 'Offset of the next slice, null at the end of the text.',
          }),
          'offset': dict({
            'description': 'Where the slice starts, in characters.',
            'type': 'integer',
          }),
          'total_chars': dict({
            'description': 'Length of the whole text.',
            'type': 'integer',
          }),
          'web_url': dict({
            'description': 'Link to the document in the Paperless web UI.',
            'type': 'string',
          }),
        }),
        'required': list([
          'document_id',
          'offset',
          'content',
          'total_chars',
          'next_offset',
          'web_url',
        ]),
        'type': 'object',
      }),
