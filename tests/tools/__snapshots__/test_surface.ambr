                  dict({
                    'type': 'string',
                  }),
                  dict({
                    'type': 'integer',
                  }),
                ]),
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Name or id; see list_taxonomy.',
