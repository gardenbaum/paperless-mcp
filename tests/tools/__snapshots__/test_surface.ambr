              'required': list([
                'id',
                'title',
                'web_url',
              ]),
              'type': 'object',
            }),
            'type': 'array',
          }),
          'truncated': dict({
            'description': 'True if the answer was cut at the size or time limit.',
            'type': 'boolean',
          }),
        }),
        'required': list([
          'answer',
          'truncated',
          'sources',
        ]),
        'type': 'object',
      }),
      'title': 'Ask Paperless AI',
    }),
    dict({
