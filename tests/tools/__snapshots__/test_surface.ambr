# name: test_the_surface_matches_the_snapshot[all]
  list([
    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'ai',
          ]),
        }),
      }),
      'annotations': dict({
        'idempotentHint': False,
        'openWorldHint': True,
        'readOnlyHint': True,
        'title': 'Ask Paperless AI',
      }),
      'description': '''
        Ask Paperless's AI a question about your documents and get its complete answer.
        
        Paperless retrieves passages of the documents the user may see (or of one document) and a
        language model writes the answer; this can take a minute and sends document text to the
        model backend. Answers are not repeatable and can be wrong: check the sources, which are
        at most three documents with web_url, or read them with get_document_content. The answer
        can be cut (truncated true). To find documents, search_documents is faster and exact.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'document_id': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Ask about this one document (id from search_documents); default all.',
          }),
          'question': dict({
            'description': 'The question in natural language, at most 4000 characters.',
            'maxLength': 4000,
            'minLength': 1,
            'type': 'string',
          }),
        }),
        'required': list([
          'question',
        ]),
        'type': 'object',
      }),
      'name': 'ask_paperless_ai',
      'outputSchema': dict({
        'description': 'The answer of the Paperless AI chat and the documents it drew on.',
        'properties': dict({
          'answer': dict({
            'type': 'string',
          }),
          'sources': dict({
            'description': 'Documents the answer drew on, as Paperless named them; may be empty.',
            'items': dict({
              'description': 'A document an answer drew on.',
              'properties': dict({
                'id': dict({
                  'type': 'integer',
                }),
                'title': dict({
                  'type': 'string',
                }),
                'web_url': dict({
                  'type': 'string',
                }),
              }),
              'required': list([
                'id',
                'title',
                'web_url',
              ]),
              'type': 'object',
            }),
            'type': 'array',
          }),
          'truncated': dict({
            'description': 'True if the answer was cut at the size or time limit.',
            'type': 'boolean',
          }),
        }),
        'required': list([
          'answer',
          'truncated',
          'sources',
        ]),
        'type': 'object',
      }),
      'title': 'Ask Paperless AI',
    }),
    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'core',
          ]),
        }),
      }),
      'annotations': dict({
        'idempotentHint': True,
        'openWorldHint': False,
        'readOnlyHint': True,
        'title': 'Download document',
      }),
      'description': '''
        Get the original file of a document, or its archive version, as an embedded resource.
        
        The file comes attached as MCP content with its MIME type and file name (also in the JSON
        report before it), never written to disk. A file over the server's download limit (512 KiB
        unless the administrator changed it) is not attached: delivered is false and the report holds
        its web_url. Use get_document_content when you only need the text.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'document_id': dict({
            'description': 'Document id, from search_documents.',
            'type': 'integer',
          }),
          'kind': dict({
            'default': 'original',
            'description': 'original: the file as it was uploaded. archive: the searchable PDF/A Paperless made from it; not every document has one (text files do not).',
            'enum': list([
              'original',
              'archive',
            ]),
            'type': 'string',
          }),
        }),
        'required': list([
          'document_id',
        ]),
        'type': 'object',
      }),
      'name': 'download_document',
      'title': 'Download document',
    }),
    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'ai',
          ]),
        }),
      }),
      'annotations': dict({
        'idempotentHint': False,
        'openWorldHint': True,
        'readOnlyHint': True,
        'title': 'Get AI suggestions',
      }),
      'description': '''
        Ask Paperless's language model to suggest a title, tags, correspondent, document type,
        storage path and dates for one document.
        
        Existing objects come with ids and names; names that do not exist yet are in the new_*
        lists and must be created before use. It can take a minute and sends the document text to
        the model backend. Needs the permission to change the document. For the cheap suggestions
        of Paperless's classifier use get_document with include suggestions.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'document_id': dict({
            'description': 'Document id, from search_documents.',
            'type': 'integer',
          }),
        }),
        'required': list([
          'document_id',
        ]),
        'type': 'object',
      }),
      'name': 'get_ai_suggestions',
      'outputSchema': dict({
        'description': 'What the language model suggests for a document; ids come with names.',
        'properties': dict({
          'correspondents': dict({
            'items': dict({
              'description': 'An object a document refers to; name is null if the user may not see it.',
              'properties': dict({
                'id': dict({
                  'type': 'integer',
                }),
                'name': dict({
                  'anyOf': list([
                    dict({
                      'type': 'string',
                    }),
                    dict({
                      'type': 'null',
                    }),
                  ]),
                }),
              }),
              'required': list([
                'id',
                'name',
              ]),
              'type': 'object',
            }),
            'type': 'array',
          }),
          'dates': dict({
            'items': dict({
              'type': 'string',
            }),
            'type': 'array',
          }),
          'document_id': dict({
            'type': 'integer',
          }),
          'document_types': dict({
            'items': dict({
              'description': 'An object a document refers to; name is null if the user may not see it.',
              'properties': dict({
                'id': dict({
                  'type': 'integer',
                }),
                'name': dict({
                  'anyOf': list([
                    dict({
                      'type': 'string',
                    }),
                    dict({
                      'type': 'null',
                    }),
                  ]),
                }),
              }),
              'required': list([
                'id',
                'name',
              ]),
              'type': 'object',
            }),
            'type': 'array',
          }),
          'new_correspondents': dict({
            'description': 'Names suggested that do not exist yet.',
            'items': dict({
              'type': 'string',
            }),
            'type': 'array',
          }),
          'new_document_types': dict({
            'items': dict({
              'type': 'string',
            }),
            'type': 'array',
          }),
          'new_storage_paths': dict({
            'items': dict({
              'type': 'string',
            }),
            'type': 'array',
          }),
          'new_tags': dict({
            'items': dict({
              'type': 'string',
            }),
            'type': 'array',
          }),
          'storage_paths': dict({
            'items': dict({
              'description': 'An object a document refers to; name is null if the user may not see it.',
              'properties': dict({
                'id': dict({
                  'type': 'integer',
                }),
                'name': dict({
                  'anyOf': list([
                    dict({
                      'type': 'string',
                    }),
                    dict({
                      'type': 'null',
                    }),
                  ]),
                }),
              }),
              'required': list([
                'id',
                'name',
              ]),
              'type': 'object',
            }),
            'type': 'array',
          }),
          'tags': dict({
            'items': dict({
              'description': 'An object a document refers to; name is null if the user may not see it.',
              'properties': dict({
                'id': dict({
                  'type': 'integer',
                }),
                'name': dict({
                  'anyOf': list([
                    dict({
                      'type': 'string',
                    }),
                    dict({
                      'type': 'null',
                    }),
                  ]),
                }),
              }),
              'required': list([
                'id',
                'name',
              ]),
              'type': 'object',
            }),
            'type': 'array',
          }),
          'title': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'description': 'A suggested title; null if none.',
          }),
          'web_url': dict({
            'type': 'string',
          }),
        }),
        'required': list([
          'document_id',
          'web_url',
          'title',
          'correspondents',
          'tags',
          'document_types',
          'storage_paths',
          'new_correspondents',
          'new_tags',
          'new_document_types',
          'new_storage_paths',
          'dates',
        ]),
        'type': 'object',
      }),
      'title': 'Get AI suggestions',
    }),
    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'core',
          ]),
        }),
      }),
      'annotations': dict({
        'idempotentHint': True,
        'openWorldHint': False,
        'readOnlyHint': True,
        'title': 'Get document',
      }),
      'description': '''
        Read one document: names, dates, tags, readable custom fields, notes count and web_url.
        
        Never returns the document text; use get_document_content for it. Custom fields are
        rendered by type: select as its label, monetary as 'EUR 12.50', document links as the
        linked documents' id and title (title null if hidden). Sections in include that the user
        may not read in Paperless (notes and history need their own permissions, the audit log can
        be off) are listed in unavailable instead of failing.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'document_id': dict({
            'description': 'Document id, from search_documents.',
            'type': 'integer',
          }),
          'include': dict({
            'anyOf': list([
              dict({
                'items': dict({
                  'enum': list([
                    'notes',
                    'history',
                    'metadata',
                    'versions',
                    'suggestions',
                  ]),
                  'type': 'string',
                }),
                'type': 'array',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "Extra sections: notes (their text), history (the newest 50 changes, no OCR text), metadata (file names, sizes, checksums), versions (file versions), suggestions (the classifier's correspondents, tags, types, paths, dates).",
          }),
        }),
        'required': list([
          'document_id',
        ]),
        'type': 'object',
      }),
      'name': 'get_document',
      'outputSchema': dict({
        'description': 'A document with names, readable custom fields and what ``include`` asked for.',
        'properties': dict({
          'added': dict({
            'format': 'date-time',
            'type': 'string',
          }),
          'archive_serial_number': dict({
