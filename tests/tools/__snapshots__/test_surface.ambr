      'annotations': dict({
        'destructiveHint': True,
        'idempotentHint': True,
        'openWorldHint': False,
        'readOnlyHint': False,
        'title': 'Delete document',
      }),
      'description': '''
        Delete a document by moving it to the Paperless trash, from where it can be restored.
        
        Two steps: call without confirm first. Nothing is deleted and the error names the document
        that would go, with confirm=true to pass. The trash keeps the document until it is emptied
        (by the administrator's retention setting or by hand); restore it in the Paperless web UI
        or with the trash toolset if enabled. Needs the permission to view and to delete documents,
        and the user must own the document, be a superuser, or the document must be unowned
        (a view or change grant is not enough).
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'confirm': dict({
            'default': False,
            'description': 'Must be true to go ahead. Without it nothing changes and the error says what would happen. Describe that to the user and pass true only once they agree, or if they already asked for exactly this.',
            'type': 'boolean',
          }),
          'document_id': dict({
            'description': 'Document id, from search_documents.',
            'type': 'integer',
          }),
        }),
        'required': list([
          'document_id',
        ]),
        'type': 'object',
      }),
      'name': 'delete_document',
      'outputSchema': dict({
        'description': 'A document that was moved to the Paperless trash.',
        'properties': dict({
          'document_id': dict({
            'type': 'integer',
          }),
          'in_trash': dict({
            'description': 'True: the document is in the trash and can be restored.',
            'type': 'boolean',
          }),
          'message': dict({
            'description': 'What happened and how to get the document back.',
            'type': 'string',
          }),
          'title': dict({
            'description': 'The title the document had.',
            'type': 'string',
          }),
        }),
        'required': list([
          'document_id',
          'title',
          'in_trash',
          'message',
        ]),
        'type': 'object',
      }),
      'title': 'Delete document',
    }),
