      'annotations': dict({
        'destructiveHint': False,
        'idempotentHint': False,
        'openWorldHint': False,
        'readOnlyHint': False,
        'title': 'Upload document',
      }),
      'description': "Upload a file to Paperless as a new document. Give the file either as path (an absolute path of a regular file inside the directories the operator allowed; symlinks are followed only to files inside them) or as base64 content_base64 with a filename. The file's type is found from its content, never from its name: PDF, PNG, JPEG, GIF, TIFF, BMP, WebP, plain text and CSV (Word, Excel, PowerPoint, OpenDocument and RTF only if Paperless runs Tika and Gotenberg). Metadata is given by name like in search_documents; an unknown or ambiguous name is an error and nothing is uploaded, and tags are never created. Custom field values are checked per data type. Paperless consumes the file later (OCR, matching, workflows), so the result holds the task_id and, with wait_seconds, the new document_id and web_url. Problems only consumption finds, such as a taken archive serial number, show as state failure with a message. Each call adds a document: uploading the same content again makes a second one on Paperless 3.x, there is no duplicate check.",
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'archive_serial_number': dict({
            'anyOf': list([
              dict({
                'maximum': 4294967295,
                'minimum': 0,
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Archive serial number; it must be unused.',
          }),
          'content_base64': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "The file's bytes as standard base64 on one line, without a data: prefix; needs filename. Not together with path.",
          }),
          'correspondent': dict({
            'anyOf': list([
              dict({
                'anyOf': list([
                  dict({
                    'type': 'string',
                  }),
                  dict({
                    'type': 'integer',
                  }),
                ]),
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Name or id; see list_taxonomy.',
          }),
          'created': dict({
            'anyOf': list([
              dict({
                'format': 'date',
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Creation date (YYYY-MM-DD); default: Paperless reads it.',
          }),
          'custom_fields': dict({
            'anyOf': list([
              dict({
                'additionalProperties': dict({
                }),
                'type': 'object',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "Custom field values keyed by field name or id. Values by data type: string/longtext text; url with scheme; date 'YYYY-MM-DD'; boolean true/false; integer; float; monetary 'EUR12.50' (or 12.5); documentlink a list of document ids; select the option's label.",
          }),
          'document_type': dict({
            'anyOf': list([
              dict({
                'anyOf': list([
                  dict({
                    'type': 'string',
                  }),
                  dict({
                    'type': 'integer',
                  }),
                ]),
              }),
              dict({
                'type': 'null',
              }),
