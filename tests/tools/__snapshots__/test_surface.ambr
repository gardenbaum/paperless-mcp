                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Archive serial number; it must be unused.',
          }),
          'content_base64': dict({
            'description': "The file's bytes as standard base64 (RFC 4648) on one line, without a data: prefix. The server refuses files over its size limit (10 MiB by default).",
