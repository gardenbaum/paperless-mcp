                'name',
                'value',
              ]),
              'type': 'object',
            }),
            'type': 'array',
          }),
          'document_type': dict({
            'anyOf': list([
              dict({
                'description': 'An object a document refers to; name is null if the user may not see it.',
                'properties': dict({
                  'id': dict({
                    'type': 'integer',
                  }),
                  'name': dict({
                    'anyOf': list([
                      dict({
                        'type': 'string',
                      }),
