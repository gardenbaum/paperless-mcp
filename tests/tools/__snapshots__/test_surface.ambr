              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "The name to upload under, e.g. 'Rechnung März.pdf'; required with content_base64, default with path: the file's own name. Directories are dropped.",
          }),
          'path': dict({
            'anyOf': list([
              dict({
                'format': 'path',
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Absolute path of the file on the machine this server runs on. Only files inside the directories the operator allowed can be read; anything else is not found. Not together with content_base64.',
