          }),
          'item': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'integer',
              }),
            ]),
            'description': 'Name or id; see list_taxonomy.',
          }),
          'kind': dict({
            'description': 'What to work on; it decides which of the other settings apply.',
            'enum': list([
              'tag',
              'correspondent',
              'document_type',
              'storage_path',
              'custom_field',
            ]),
            'type': 'string',
          }),
        }),
        'required': list([
          'kind',
          'item',
        ]),
        'type': 'object',
      }),
      'name': 'delete_taxonomy_item',
